{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/scripts/briefing.mjs\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell",
  "hooks": [{ "type": "command", "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/protect-secrets.mjs\"" }] },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/protect-files.mjs\"" }]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/block-danger.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/gates/run-gates.mjs\" --quick" },          
          { "type": "command", "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/scripts/check-hooks-on-edit.mjs\"" }
          ]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/gates/graph-stop.mjs\"" }] }
    ]
  }
}
