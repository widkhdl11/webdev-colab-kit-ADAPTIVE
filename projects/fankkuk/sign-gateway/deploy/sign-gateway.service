[Unit]
Description=fankkuk sign gateway (Kakao certificate e-signature via fixed IP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sign-gateway
Group=sign-gateway
EnvironmentFile=/etc/sign-gateway/sign-gateway.env
ExecStart=/usr/bin/node /opt/sign-gateway/server.mjs
WorkingDirectory=/opt/sign-gateway
Restart=on-failure
RestartSec=3
# 설정 오류(78)면 재시작을 반복하지 않는다 — journalctl 로 원인을 본다
RestartPreventExitStatus=78

# 443 을 root 없이 연다
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# 파일 시스템·커널 접근을 막는다
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
ProtectProc=invisible

# 인스턴스 메타데이터(169.254.169.254)로는 커널 단계에서도 못 나간다 — 코드의 허용 목록과 별개인 두 번째 벽
IPAddressDeny=169.254.0.0/16 fd00:ec2::254/128

MemoryMax=200M

[Install]
WantedBy=multi-user.target
