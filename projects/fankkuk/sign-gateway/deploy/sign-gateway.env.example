# 서명 게이트웨이 환경 변수 — 서버의 /etc/sign-gateway/sign-gateway.env 에만 둔다.
# 이 틀 파일에는 값을 적지 않는다. 드림시큐리티·카카오·KMS 값은 Vercel 과 저장소 어디에도 두지 않는다.
# 값을 바꾼 뒤: sudo systemctl restart sign-gateway
# 비어 있거나 __FILL_ME__ 인 칸은 「아직 안 채움」으로 읽는다.

# ── 게이트웨이 자체 (설치 스크립트가 채운다) ─────────────────────────
# Vercel 앱 서버가 Authorization: Bearer <값> 으로 보내는 비밀 토큰. 설치 때 무작위로 만든다.
# Vercel 에는 이 값 하나만 SIGN_GATEWAY_TOKEN 으로 넣는다.
GATEWAY_TOKEN=__FILL_ME__
# 토큰을 바꿀 때만: 새 값을 여기 넣고 재시작 → Vercel 을 새 값으로 → GATEWAY_TOKEN 을 새 값으로, 이 칸은 비움
GATEWAY_TOKEN_NEXT=

# dreamsecurity(운영) | test(가짜 서명 — 결과의 서명 방식이 fake 라 운영 DB 가 받지 않는다)
SIGN_ADAPTER=dreamsecurity

LISTEN_HOST=0.0.0.0
LISTEN_PORT=443
TLS_CERT_FILE=/etc/sign-gateway/tls/fullchain.pem
TLS_KEY_FILE=/etc/sign-gateway/tls/privkey.pem

# 게이트웨이가 요청을 보낼 수 있는 호스트(쉼표로 구분, 정확한 이름). dreamsecurity.com·kakao.com 아래만 허용되고,
# 그 밖을 적으면 서버가 뜨지 않는다. 드림시큐리티 명세의 API 호스트를 적는다.
OUTBOUND_ALLOWED_HOSTS=

# ── 드림시큐리티 (직접 채운다) ─────────────────────────────────────
DREAM_API_BASE_URL=__FILL_ME__
DREAM_CLIENT_ID=__FILL_ME__
DREAM_CLIENT_SECRET=__FILL_ME__

# ── 카카오 (직접 채운다) ──────────────────────────────────────────
KAKAO_CLIENT_ID=__FILL_ME__
KAKAO_CLIENT_SECRET=__FILL_ME__

# ── 송장 출력 함수 (주소를 여는 곳 — 직접 채운다) ──────────────────────
# 이 값들은 이 서버에만 둔다. 특히 DECRYPT_DB_KEY 는 Vercel 에 넣지 않는다(앱 서버가 주소를 직접 열 수 있게 된다).
# SUPABASE_URL 은 https://<프로젝트>.supabase.co 꼴만 받는다 — 송장 출력 함수가 요청을 보낼 수 있는 DB 주소가 이것 하나가 된다.
SUPABASE_URL=__FILL_ME__
SUPABASE_PUBLISHABLE_KEY=__FILL_ME__
# 복호화 전용 역할(address_decryptor) DB 토큰
DECRYPT_DB_KEY=__FILL_ME__
# 대표 계정 ID — 이 계정의 로그인 토큰으로만 주소가 열린다
DECRYPT_OWNER_USER_ID=__FILL_ME__
# 시험 사이트를 이 게이트웨이에 붙일 때만: 1 + 시험 사이트 주소. 둘 다 맞아야 저장된 가짜 서명을 재검증에서 받는다.
# 그리고 SUPABASE_URL 이 코드(lib/config.mjs 의 TEST_SITE_SUPABASE_HOSTS)에 적힌 시험 프로젝트여야 한다 — 아니면 서버가 뜨지 않는다
FANKKUK_TEST_SITE=
APP_ORIGIN=

# ── AWS KMS (직접 채운다 — deploy/kms-iam-policy.json 만 붙은 IAM 사용자의 키) ──
AWS_REGION=ap-northeast-2
KMS_KEY_ID=__FILL_ME__
AWS_ACCESS_KEY_ID=__FILL_ME__
AWS_SECRET_ACCESS_KEY=__FILL_ME__
