# signal 환경변수 — 이 파일은 이름만 담는 견본이다(값 없음). 실제 값은 .env 에 두고,
# .env 는 .gitignore 대상이라 커밋되지 않는다. 훅(protect-secrets)이 .env 내용 출력도 막는다.
#
# 어디에 무엇을 두나 — 셋으로 나뉜다.

# ── ① 브라우저까지 가는 값 (NEXT_PUBLIC_ 접두사) ───────────────────────────
# Next 가 클라이언트 번들에 문자열로 인라인한다. 즉 공개된다고 봐야 한다.
# publishable(구 anon) 키는 공개를 전제로 설계된 키다 — 인가는 이 키가 아니라 RLS 가 한다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_... 또는 구 anon 키>

# ── ② 서버에서만 쓰는 값 (.env 에 두되 NEXT_PUBLIC_ 을 붙이지 않는다) ───────
# 수집·요약은 서버(Route Handler / Cron)에서만 돈다. 이 값들이 클라 번들에 나타나면
# 게이트 NO_HARDCODED_SECRET 와 INV-S4 위반이다.
# 아직 수집 파이프라인을 안 만들었으므로 지금은 비워 둬도 된다.
SUPABASE_SECRET_KEY=<sb_secret_... 또는 구 service_role 키 — 서버 전용>
ANTHROPIC_API_KEY=<요약 생성용 — 서버 전용>

# ── ③ 저장소 밖(OS 사용자 환경변수)에 두는 값 — .env 에 넣지 않는다 ─────────
# SUPABASE_TOKEN        Management API 토큰. 조직 전체를 건드릴 수 있어서 파일에 두지 않는다.
#                       scripts/apply-migrations.mjs 는 process.env 에서만 읽고 파일은 안 읽는다.
# SUPABASE_PROJECT_REF  프로젝트 ref. 비밀은 아니지만(DECISIONS 2026-07-24) 스크립트가 환경변수로 받는다.

# 이어달리기가 다음 호출을 보낼 우리 배포 주소 (ingest-chaining-budget INV-CB1·CB2).
# 한 바퀴가 300초 안에 안 끝나면 남은 일을 다음 호출에 넘기는데, 그 목적지가 이 값이다.
# 비밀이 아니다. 없으면 이어달리기를 하지 않고 한 호출만 돌고 정상으로 끝낸다 —
# 요청 헤더의 호스트로 대신 추측하지 않는다(그건 남이 보낸 값이고, 그 주소로 가는
# 요청에는 CRON_SECRET 이 실린다).
# 로컬: http://localhost:3210 / 배포: https://<우리 도메인>
INGEST_BASE_URL=
