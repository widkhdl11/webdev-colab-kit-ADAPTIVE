{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node scripts/briefing.mjs" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|PowerShell",
  "hooks": [{ "type": "command", "command": "node .claude/hooks/protect-secrets.mjs" }] },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/protect-files.mjs" }]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/block-danger.mjs" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node gates/run-gates.mjs --quick" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node gates/graph-stop.mjs" }] }
    ]
  }
}
