{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/scripts/briefing.mjs\""
          }
        ]
      },
      { 
        "hooks": [ 
          { "type": "command", "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/scripts/session-sync.mjs\" start" } 
          ] 
        }
      ],
      "UserPromptSubmit": [
        { "hooks": [ { "type": "command", "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/scripts/session-sync.mjs\" prompt" } ] 
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/protect-secrets.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/protect-files.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/block-danger.mjs\""
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/report-subagent.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/loop-lock.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/gates/run-gates.mjs\" --quick"
          },
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/scripts/check-hooks-on-edit.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/report-activity.mjs\""
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/report-subagent.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/gates/graph-stop.mjs\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/session-size.mjs\""
          },
           {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/scripts/check-progress-fresh.mjs\""
          },
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/scripts/session-sync.mjs\" stop"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/PC/Desktop/dev/webdeb-colab-kit-ADAPTIVE/.claude/hooks/report-subagent.mjs\""
          }
        ]
      }
    ]
  }
}